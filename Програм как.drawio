        <mxCell id="jMu4TiEwKi8SUWL0U_Gk-19" parent="1" style="text;whiteSpace=wrap;" value="┌─────────┐&#xa;│  НАЧАЛО │&#xa;└────┬────┘&#xa;     ▼&#xa;┌─────────────────────────────┐&#xa;│ ВВОД: num = 15              │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;        ┌─────────────┐&#xa;        │ num % 2 == 0?│ ◄── Ромб (условие)&#xa;        └──────┬──────┘&#xa;      Да ▼     │ Нет&#xa;┌──────────────┴──────────────┐&#xa;▼                             ▼&#xa;┌─────────────────────┐       ┌───────────────────────┐&#xa;│ ВЫВОД:              │       │ ВЫВОД:                │&#xa;│ &quot;15 — чётное число.&quot;│       │ &quot;15 — нечётное число.&quot;│&#xa;└────────────┬────────┘       └────────────┬──────────┘&#xa;             └───────────────┬─────────────┘&#xa;                             ▼&#xa;                          ┌─────────┐&#xa;                          │  КОНЕЦ  │&#xa;                          └─────────┘" vertex="1">
