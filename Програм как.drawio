        <mxCell id="jMu4TiEwKi8SUWL0U_Gk-13" parent="1" style="text;whiteSpace=wrap;" value="┌─────────┐&#xa;│  НАЧАЛО │&#xa;└────┬────┘&#xa;     ▼&#xa;┌─────────────────────────────┐&#xa;│ ВВОД: num1 = 7.0            │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────────────────────────┐&#xa;│ ВВОД: num2 = 12.0           │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────────────────────────┐&#xa;│ ВЫЧИСЛЕНИЕ:                 │&#xa;│ average = (7.0 + 12.0) / 2  │&#xa;│         = 19.0 / 2          │&#xa;│         = 9.5               │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────────────────────────┐&#xa;│ ВЫВОД:                      │&#xa;│ &quot;Среднее арифметическое:    │&#xa;│  9.5&quot;                       │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────┐&#xa;│  КОНЕЦ  │&#xa;└─────────┘" vertex="1">
