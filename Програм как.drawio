        <mxCell id="jMu4TiEwKi8SUWL0U_Gk-27" parent="1" style="text;whiteSpace=wrap;" value="┌───────────────┐&#xa;│     НАЧАЛО    │&#xa;└───────┬───────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ВВОД:             │&#xa;│ text = input()    │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ИНИЦИАЛИЗАЦИЯ:    │&#xa;│ count = 0         │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;   ┌─────────────┐&#xa;   │ for char in │&#xa;   │    text:    │ ◄── Цикл по символам&#xa;   └──────┬──────┘&#xa;          │&#xa;          ▼&#xa;   ┌─────────────┐&#xa;   │ char.isdigit?│ ◄── Проверка символа&#xa;   └────────────┘&#xa;     Да ▼ │ Нет&#xa;┌──────────┴──────────┐&#xa;│                     │&#xa;▼                     ▼&#xa;┌─────────────┐   ┌─────────────┐&#xa;│ count += 1  │   │ (пропуск)   │&#xa;└──────┬──────┘   └──────┬──────┘&#xa;       │                 │&#xa;       └────────┬────────┘&#xa;                ▼&#xa;        ┌───────────────┐&#xa;        │ Есть ещё      │&#xa;        │ символы?      │&#xa;        └───────┬───────┘&#xa;          Да ▼ │ Нет&#xa;        ┌──────┴──────┐&#xa;        │             │&#xa;        └─────────────┘&#xa;        (возврат к циклу)&#xa;                │&#xa;                ▼&#xa;┌───────────────────────┐&#xa;│ ВЫВОД:                │&#xa;│ &quot;Количество арабских  │&#xa;│  цифр: {count}&quot;       │&#xa;└───────────┬───────────┘&#xa;            ▼&#xa;         ┌─────────┐&#xa;         │  КОНЕЦ  │&#xa;         └─────────" vertex="1">
