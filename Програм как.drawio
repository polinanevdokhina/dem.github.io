        <mxCell id="jMu4TiEwKi8SUWL0U_Gk-20" parent="1" style="text;whiteSpace=wrap;" value="┌─────────┐&#xa;│  НАЧАЛО │&#xa;└────┬────┘&#xa;     ▼&#xa;┌─────────────────────────────┐&#xa;│ ВВОД: num1 = 9.0            │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────────────────────────┐&#xa;│ ВВОД: num2 = 5.0            │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;        ┌─────────────┐&#xa;        │ num1 &lt; num2?│ ◄── Ромб (условие)&#xa;        └──────┬──────┘&#xa;      Да ▼     │ Нет  ← выполняется эта ветка&#xa;┌──────────────┴──────────────┐&#xa;│                             ▼&#xa;│                  ┌─────────────────────┐&#xa;│                  │ ВЫЧИСЛЕНИЕ:         │&#xa;│                  │ result = 9.0 - 5.0  │&#xa;│                  │ result = 4.0        │&#xa;│                  └──────────┬──────────┘&#xa;│                             ▼&#xa;│                  ┌─────────────────────┐&#xa;│                  │ ВЫВОД:              │&#xa;│                  │ «Первое число не    │&#xa;│                  │ меньше второго.     │&#xa;│                  │ Разность (первое -  │&#xa;│                  │ второе): 4.0»       │&#xa;│                  └──────────┬──────────┘&#xa;│                             ▼&#xa;│                          ┌─────────┐&#xa;│                          │  КОНЕЦ  │&#xa;└──────────────────────────└─────────┘" vertex="1">
          <mxGeometry height="530" width="380" x="550" y="580" as="geometry" />
        </mxCell>
        <mxCell id="jMu4TiEwKi8SUWL0U_Gk-22" parent="1" style="text;whiteSpace=wrap;" value="┌─────────┐&#xa;│  НАЧАЛО │&#xa;└────┬────┘&#xa;     ▼&#xa;┌─────────────────────────────┐&#xa;│ ИНИЦИАЛИЗАЦИЯ:              │&#xa;│ count_even = 0              │&#xa;│ i = 0                       │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;        ┌─────────────┐&#xa;        │  i &lt; 10?    │ ◄── Условие цикла&#xa;        └──────┬──────┘&#xa;      Нет ▼    │ Да&#xa;┌──────────────┴──────────────┐&#xa;▼                             ▼&#xa;┌─────────────────────┐   ┌─────────────────────────┐&#xa;│ ВЫВОД:              │   │ ВВОД: num = int(input)  │&#xa;│ «Количество четных  │   │ (в блоке try)           │&#xa;│  чисел: 5»          │   └────────────┬────────────┘&#xa;└────────────┬────────┘                ▼&#xa;             │                ┌─────────────────┐&#xa;             │                │ Ввод валиден?   │&#xa;             │                └───────┬─────────┘&#xa;             │                  Да ▼ │ Нет&#xa;             │         ┌──────────────┴──────────────┐&#xa;             │         ▼                              ▼&#xa;             │  ┌─────────────┐             ┌─────────────────────┐&#xa;             │  │ num % 2 == 0│             │ ВЫВОД ОШИБКИ:       │&#xa;             │  └──────┬──────┘             │ «Ошибка: не целое»  │&#xa;             │    Да ▼ │ Нет               └──────────┬──────────┘&#xa;             │ ┌────────┴────────┐                    ▼&#xa;             │ ▼                 ▼          ┌─────────────────┐&#xa;             │ count_even += 1 │ (пропуск)  │ i = i + 1       │&#xa;             │ └────────┬────────┘          └────────┬────────┘&#xa;             │          ▼                           │&#xa;             │   ┌─────────────┐                    │&#xa;             │   │ i = i + 1   │◄───────────────────┘&#xa;             │   └──────┬──────┘&#xa;             │          │&#xa;             └──────────┘ (возврат к i &lt; 10?)" vertex="1">
          <mxGeometry height="610" width="490" x="1470" y="750" as="geometry" />
        </mxCell>
        <mxCell id="jMu4TiEwKi8SUWL0U_Gk-23" parent="1" style="text;whiteSpace=wrap;" value="┌───────────────┐&#xa;│     НАЧАЛО    │&#xa;───────┬───────┘&#xa;        ▼&#xa;┌───────────────────────────┐&#xa;│ ИНИЦИАЛИЗАЦИЯ             │&#xa;│ pos_count = 0             │&#xa;│ neg_count = 0             │&#xa;│ zero_count = 0            │&#xa;│ i = 0                     │&#xa;└─────────────┬─────────────┘&#xa;              ▼&#xa;        ┌─────────────┐&#xa;        │    i &lt; 10?  │ ◄── Условие цикла (10 раз)&#xa;        └────────────┘&#xa;          Нет  │  Да&#xa;        ┌────────────┐&#xa;        ▼             ▼&#xa;──────────────┐ ┌───────────────────────┐&#xa;│ ВЫВОД итогов │ │ ВВОД: num = int(input)│&#xa;│ (результатов)│ │ (блок try)            │&#xa;└──────┬─────── └───────────┬───────────&#xa;       │                     ▼&#xa;       │             ┌───────────────────┐&#xa;       │             │ Ввод корректен?   │&#xa;       │             └────────┬──────────┘&#xa;       │               Да ▼   │ Нет&#xa;       │        ┌─────────────┴──────────────┐&#xa;       │        ▼                            ▼&#xa;       │   ┌───────────┐           ┌───────────────────────────┐&#xa;       │   │ num &gt; 0?  │           │ ВЫВОД: &quot;Ошибка...&quot;        │&#xa;       │   └─────┬─────┘           └─────────────┬─────────────┘&#xa;       │    Да ▼ │ Нет                   ┌───────┴───────┐&#xa;       │  ┌───────────┐           ┌──────►│  i = i + 1    │&#xa;       │  │pos_count+=1│           │       └───────┬───────┘&#xa;       │  └───────────┘           │               │&#xa;       │          │               ▼               │&#xa;       │          ▼        ┌───────────┐          │&#xa;       │   ┌───────────┐   │ num &lt; 0?  │          │&#xa;       │   │neg_count+=1│  └─────┬─────┘          │&#xa;       │   └───────────┘    Да ▼ │ Нет            │&#xa;       │          │      ┌───────────┐            │&#xa;       │          │      │zero_count+│            │&#xa;       │          │      │    += 1   │            │&#xa;       │          │      ─────┬─────┘            │&#xa;       │          └──────────┘ │                 │&#xa;       │                 ▼     │                 │&#xa;       │          ┌────────────┴─────────────────┘&#xa;       │          ▼&#xa;       └─────────────────────────────────────────┘&#xa;                  (Возврат к проверке i &lt; 10)" vertex="1">
