        <mxCell id="jMu4TiEwKi8SUWL0U_Gk-14" parent="1" style="text;whiteSpace=wrap;" value="┌─────────┐&#xa;│  НАЧАЛО │&#xa;└────┬────┘&#xa;     ▼&#xa;┌─────────────────────────────┐&#xa;│ ВВОД: num1 = 4.0            │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────────────────────────┐&#xa;│ ВВОД: num2 = 9.0            │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────────────────────────┐&#xa;│ ВЫЧИСЛЕНИЕ:                 │&#xa;│ product = 4.0 * 9.0 = 36.0  │&#xa;│ geo_mean = √36.0 = 6.0      │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────────────────────────┐&#xa;│ ВЫВОД:                      │&#xa;│ &quot;Среднее геометрическое:    │&#xa;│  6.0&quot;                       │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────┐&#xa;│  КОНЕЦ  │&#xa;└─────────┘" vertex="1">
