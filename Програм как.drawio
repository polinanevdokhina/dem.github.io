        <mxCell id="jMu4TiEwKi8SUWL0U_Gk-31" parent="1" style="text;whiteSpace=wrap;" value="┌───────────────┐&#xa;│     НАЧАЛО    │&#xa;│ guess_number_ │&#xa;│    game()     │&#xa;└───────┬───────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ВЫВОД:            │&#xa;│ &quot;🎮 Игра:         │&#xa;│  Компьютер        │&#xa;│  угадывает число&quot; │&#xa;│ &quot;=&quot; * 42          │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;   ┌─────────────┐&#xa;   │ ВВОД N, M   │&#xa;   │ с проверкой │&#xa;   └──────┬──────&#xa;          ▼&#xa;   ┌─────────────┐&#xa;   │ while True: │&#xa;   └──────┬──────┘&#xa;          ▼&#xa;   ┌─────────────┐&#xa;   │   try:      │&#xa;   │ N = int()   │&#xa;   │ M = int()   │&#xa;   └──────┬──────&#xa;          ▼&#xa;   ┌─────────────┐&#xa;   │   N &gt;= M?   │&#xa;   └──────┬──────┘&#xa;   Да ▼   │ Нет&#xa;┌─────────┴─────────┐&#xa;│Вывод ошибки:      │&#xa;│&quot;N &lt; M обязательно&quot;│&#xa;└─────────┬─────────┘&#xa;          │&#xa;          ▼&#xa;   ┌─────────────┐&#xa;   │    break    │&#xa;   └──────┬──────┘&#xa;          │&#xa;          ▼&#xa;   ┌─────────────┐&#xa;   │except:      │&#xa;   │&quot;Введите целые│&#xa;   │   числа&quot;    │&#xa;   └──────┬──────┘&#xa;          │&#xa;          └──────────────┐&#xa;                         │&#xa;        ▼                │&#xa;┌─────────────────┐      │&#xa;│ ВЫВОД:          │      │&#xa;│ &quot;Загадайте число│      │&#xa;│  от {N} до {M}&quot; │      │&#xa;└────────┬────────┘      │&#xa;         │                │&#xa;         ▼                │&#xa;┌─────────────────┐      │&#xa;│ ИНИЦИАЛИЗАЦИЯ:  │      │&#xa;│ low = N         │      │&#xa;│ high = M        │      │&#xa;│ attempts = 0    │◄─────┘&#xa;└────────┬────────&#xa;         ▼&#xa;    ┌─────────────┐&#xa;    │low &lt; high?  │ ◄── Цикл двоичного поиска&#xa;    └──────┬──────┘&#xa;      Нет  │ Да&#xa;    ┌─────────────┐&#xa;    ▼              ▼&#xa;┌────────────  ┌─────────────────┐&#xa;│   РЕЗУЛЬТАТ │ │ mid = (low+high)//2&#xa;│ Вывод числа │ │ attempts += 1&#xa;│ и статистики│ └────────┬────────&#xa;└────────────  │          ▼&#xa;               │   ┌─────────────┐&#xa;               │   │ ВВОД ответа │&#xa;               │   │ &quot;Ваше число │&#xa;               │   │  больше {mid}?&quot;&#xa;               │   └──────┬──────┘&#xa;               │          ▼&#xa;               │   ┌─────────────┐&#xa;               │   │while True:  │&#xa;               │   │ Проверка    │&#xa;               │   │ ans in      │&#xa;               │   │ (да,нет,y,n)│&#xa;               │   └──────┬──────┘&#xa;               │          ▼&#xa;               │   ┌─────────────┐&#xa;               │   │ is_greater? │&#xa;               │   └──────┬──────┘&#xa;               │          ▼&#xa;               │   ┌─────────────┐&#xa;               │   │   break     │&#xa;               │   └──────┬──────┘&#xa;               │          │&#xa;               │          ▼&#xa;               │   ┌─────────────┐&#xa;               │   │ is_greater? │&#xa;               │   └──────┬──────┘&#xa;               │     Да ▼ │ Нет&#xa;               │   ┌──────┴──────┐&#xa;               │   ▼             ▼&#xa;               │ low = mid + 1  high = mid&#xa;               │   │             │&#xa;               │   └──────┬──────┘&#xa;               │          ▼&#xa;               │   ┌─────────────┐&#xa;               │   │ low &gt; high? │&#xa;               │   │ (Проверка   │&#xa;               │   │  честности) │&#xa;               │   └──────┬──────┘&#xa;               │     Да ▼ │ Нет&#xa;               │   ┌──────┴──────┐&#xa;               │   ▼             │&#xa;               │ Вывод ошибки:   │&#xa;               │ &quot;Диапазон пуст&quot; │&#xa;               │ return          │&#xa;               │                 │&#xa;               └─────────────────┘&#xa;                   (возврат к low &lt; high?)&#xa;                         ▼&#xa;                  ┌─────────────┐&#xa;                  │    КОНЕЦ    │&#xa;                  └─────────────┘" vertex="1">
