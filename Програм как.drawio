        <mxCell id="jMu4TiEwKi8SUWL0U_Gk-28" parent="1" style="text;whiteSpace=wrap;" value="┌───────────────┐&#xa;│     НАЧАЛО    │&#xa;└───────┬───────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ВВОД:             │&#xa;│ text = input(     │&#xa;│  &quot;Введите текст:&quot; │&#xa;│       )           │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ОБРАБОТКА:        │&#xa;│ result = text.    │&#xa;│  replace(&quot; &quot;, &quot;&quot;) │&#xa;│  (удалить все     │&#xa;│   пробелы)        │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ВЫВОД:            │&#xa;│ &quot;Текст без        │&#xa;│  пробелов:        │&#xa;│  {result}&quot;        │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;     ┌─────────┐&#xa;     │  КОНЕЦ  │&#xa;     └─────────" vertex="1">
