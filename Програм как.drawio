        <mxCell id="jMu4TiEwKi8SUWL0U_Gk-17" parent="1" style="text;whiteSpace=wrap;" value="┌─────────┐&#xa;│  НАЧАЛО │&#xa;└────┬────┘&#xa;     ▼&#xa;┌─────────────────────────────┐&#xa;│ ВВОД: N = 7                 │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────────────────────────┐&#xa;│ ВЫЧИСЛЕНИЕ:                 │&#xa;│ v1 = (7 - 1) ** 2 = 36      │&#xa;│ v2 = 7 ** 2       = 49      │&#xa;│ v3 = (7 + 1) ** 2 = 64      │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────────────────────────┐&#xa;│ ВЫВОД:                      │&#xa;│ &quot;36, 49, 64&quot;                │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────┐&#xa;│  КОНЕЦ  │&#xa;└─────────┘" vertex="1">
