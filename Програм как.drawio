        <UserObject label="┌───────────────┐&#xa;│     НАЧАЛО    │&#xa;└───────┬───────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ numbers = []      │&#xa;│ i = 0             │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ВЫВОД:            │&#xa;│ &quot;Введите 10 чисел&quot;│&#xa;└───────┬───────────┘&#xa;        ▼&#xa;   ┌─────────────┐&#xa;   │   i &lt; 10?   │ ◄── Условие внешнего цикла&#xa;   └──────┬──────┘&#xa;     Нет  │  Да&#xa;   ┌─────────────┐&#xa;   ▼              ▼&#xa;┌────────────  ┌───────────────────┐&#xa;│ max_val =  │  │  ВНУТРЕННИЙ ЦИКЛ  │&#xa;│ max(nums)  │  │  (while True)     │&#xa;└──────┬─────┘  └─────────┬─────────┘&#xa;       │                   ▼&#xa;┌────────────┐      ┌───────────────┐&#xa;│ min_val =  │      │ ВВОД: num =   │&#xa;│ min(nums)  │      │ int(input)    │&#xa;└──────┬─────┘      └───────┬───────┘&#xa;       │                     ▼&#xa;┌────────────┐       ┌───────────────┐&#xa;│ diff =     │       │ Ввод валиден? │&#xa;│ max - min  │       │ (try/except)  │&#xa;└──────┬─────       └──────────────┘&#xa;       │               Да ▼  │ Нет&#xa;       │          ┌──────────┴──────────┐&#xa;       │          ▼                     ▼&#xa;       │   ┌───────────────┐    ┌───────────────┐&#xa;       │   │ numbers.append│    │ ВЫВОД ОШИБКИ: │&#xa;       │   │ (добавить в   │    │ &quot;Введите целое│&#xa;       │   │   список)     │    │   число&quot;      │&#xa;       │   └───────┬───────┘    └───────┬───────┘&#xa;       │           ▼                    │&#xa;       │   ┌───────────────┐            │&#xa;       │   │ i = i + 1     │◄───────────┘&#xa;       │   └───────┬───────┘&#xa;       │           │&#xa;       └───────────┘&#xa;           (Возврат к проверке i &lt; 10)&#xa;           ▼&#xa;┌───────────────────┐&#xa;│ ВЫВОД РЕЗУЛЬТАТОВ │&#xa;│ (max, min, diff)  │&#xa;└─────────┬─────────┘&#xa;          ▼&#xa;       ┌─────────┐&#xa;       │  КОНЕЦ  │&#xa;       └─────────" link="┌───────────────┐&#xa;