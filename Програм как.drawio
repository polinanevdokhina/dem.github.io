        <mxCell id="jMu4TiEwKi8SUWL0U_Gk-15" parent="1" style="text;whiteSpace=wrap;" value="┌─────────┐&#xa;│  НАЧАЛО │&#xa;└────┬────┘&#xa;     ▼&#xa;┌─────────────────────────────┐&#xa;│ ВВОД: a = 3.0               │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────────────────────────┐&#xa;│ ВВОД: b = 4.0               │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;        ┌─────────────┐&#xa;        │ a &gt; 0 и     │&#xa;        │ b &gt; 0?      │&#xa;        └──────┬──────┘&#xa;      Да ▼     │ Нет&#xa;┌─────────────┴─────────────┐&#xa;│ ВЫВОД ОШИБКИ              │&#xa;│ «Длины должны быть &gt; 0»   │&#xa;└─────────────┬─────────────┘&#xa;              ▼&#xa;      ┌─────────────┐&#xa;      │ ВЫЧИСЛЕНИЕ: │&#xa;      │ c = √(3²+4²)│&#xa;      │ c = 5.00    │&#xa;      └──────┬──────┘&#xa;             ▼&#xa;      ┌─────────────┐&#xa;      │ ВЫЧИСЛЕНИЕ: │&#xa;      │ S = (3×4)/2 │&#xa;      │ S = 6.00    │&#xa;      └──────┬──────┘&#xa;             ▼&#xa;┌─────────────────────────────┐&#xa;│ ВЫВОД:                      │&#xa;│ «Гипотенуза: 5.00»          │&#xa;│ «Площадь: 6.00»             │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────┐&#xa;│  КОНЕЦ  │&#xa;└─────────┘" vertex="1">
