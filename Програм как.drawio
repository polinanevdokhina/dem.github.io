        <mxCell id="jMu4TiEwKi8SUWL0U_Gk-29" parent="1" style="text;whiteSpace=wrap;" value="┌───────────────┐&#xa;│     НАЧАЛО    │&#xa;└───────┬───────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ВВОД:             │&#xa;│ text = input(     │&#xa;│  &quot;Введите строку:&quot;│&#xa;│       )           │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ОБРАБОТКА:        │&#xa;│ words = text.     │&#xa;│         split()   │&#xa;│ (разбить на слова)│&#xa;└───────┬───────────┘&#xa;        ▼&#xa;   ┌─────────────┐&#xa;   │   words?    │ ◄── Проверка: список не пуст?&#xa;   │ (if words:) │     (True если есть элементы)&#xa;   └────────────┘&#xa;     Да ▼ │ Нет&#xa;┌──────────┴──────────┐&#xa;│                     │&#xa;▼                     ▼&#xa;┌─────────────────┐ ┌─────────────────────┐&#xa;│ ВЫВОД:          │ │ ВЫВОД:              │&#xa;│ &quot;Первое слово:  │ │ &quot;⚠ Строка пуста или │&#xa;│  {words[0]}&quot;    │ │  содержит только    │&#xa;└────────┬──────── │  пробелы.&quot;          │&#xa;         │          └──────────┬──────────┘&#xa;         │                     │&#xa;         └──────────┬──────────┘&#xa;                    ▼&#xa;                 ┌─────────┐&#xa;                 │  КОНЕЦ  │&#xa;                 └─────────" vertex="1">
          <mxGeometry height="570" width="410" x="1500" y="2200" as="geometry" />
        </mxCell>
        <UserObject label="┌───────────────┐&#xa;│     НАЧАЛО    │&#xa;└───────┬───────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ВВОД:             │&#xa;│ text = input(     │&#xa;│  &quot;Введите текст   │&#xa;│   для сохранения:&quot;│&#xa;│       )           │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ВВОД:             │&#xa;│ filename = input( │&#xa;│  &quot;Введите имя     │&#xa;│   файла:&quot;         │&#xa;│       )           │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ОТКРЫТИЕ ФАЙЛА:   │&#xa;│ with open(        │&#xa;│   filename,       │&#xa;│   &#39;w&#39;,            │&#xa;│   encoding=&#39;utf-8&#39;│&#xa;│ ) as file:        │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ЗАПИСЬ В ФАЙЛ:    │&#xa;│ file.write(text)  │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ЗАКРЫТИЕ ФАЙЛА:   │&#xa;│ (автоматическое   │&#xa;│  при выходе из    │&#xa;│  with)            │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ВЫВОД:            │&#xa;│ &quot;✅ Текст успешно │&#xa;│  сохранён в файл  │&#xa;│  &#39;{filename}&#39;.&quot;   │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;     ┌─────────┐&#xa;     │  КОНЕЦ  │&#xa;     └─────────" link="┌───────────────┐&#xa;│     НАЧАЛО    │&#xa;└───────┬───────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ВВОД:             │&#xa;│ text = input(     │&#xa;│  &quot;Введите текст   │&#xa;│   для сохранения:&quot;│&#xa;│       )           │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ВВОД:             │&#xa;│ filename = input( │&#xa;│  &quot;Введите имя     │&#xa;│   файла:&quot;         │&#xa;│       )           │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ОТКРЫТИЕ ФАЙЛА:   │&#xa;│ with open(        │&#xa;│   filename,       │&#xa;│   &#39;w&#39;,            │&#xa;│   encoding=&#39;utf-8&#39;│&#xa;│ ) as file:        │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ЗАПИСЬ В ФАЙЛ:    │&#xa;│ file.write(text)  │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ЗАКРЫТИЕ ФАЙЛА:   │&#xa;│ (автоматическое   │&#xa;│  при выходе из    │&#xa;│  with)            │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ВЫВОД:            │&#xa;│ &quot;✅ Текст успешно │&#xa;│  сохранён в файл  │&#xa;│  &#39;{filename}&#39;.&quot;   │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;     ┌─────────┐&#xa;     │  КОНЕЦ  │&#xa;     └─────────" id="jMu4TiEwKi8SUWL0U_Gk-30">
