        <mxCell id="jMu4TiEwKi8SUWL0U_Gk-12" parent="1" style="text;whiteSpace=wrap;" value="┌─────────┐&#xa;│  НАЧАЛО │&#xa;└────┬────┘&#xa;     ▼&#xa;┌─────────────────────────────┐&#xa;│ ВВОД: length = 5.0          │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────────────────────────┐&#xa;│ ВВОД: width = 3.0           │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────────────────────────┐&#xa;│ ВЫЧИСЛЕНИЕ:                 │&#xa;│ area = 5.0 * 3.0 = 15.0     │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────────────────────────┐&#xa;│ ВЫВОД:                      │&#xa;│ &quot;Площадь прямоугольника:    │&#xa;│  15.0&quot;                      │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────┐&#xa;│  КОНЕЦ  │&#xa;└─────────┘" vertex="1">
