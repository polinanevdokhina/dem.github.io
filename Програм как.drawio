        <mxCell id="jMu4TiEwKi8SUWL0U_Gk-26" parent="1" style="text;whiteSpace=wrap;" value="┌───────────────┐&#xa;│     НАЧАЛО    │&#xa;└───────┬───────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ A = []            │&#xa;│ i = 0             │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ВЫВОД:            │&#xa;│ &quot;Введите 10 чисел&quot;│&#xa;└───────┬───────────┘&#xa;        ▼&#xa;   ┌─────────────┐&#xa;   │   i &lt; 10?   │ ◄── Внешний цикл (for)&#xa;   └──────┬──────┘&#xa;     Нет  │  Да&#xa;   ┌─────────────┐&#xa;   ▼              ▼&#xa;┌────────────  ┌───────────────────┐&#xa;│ sum_even = │  │ ВНУТРЕННИЙ ЦИКЛ   │&#xa;│ sum(A[0::2])│  │ (while True)      │&#xa;└───────────┘  └─────────┬─────────┘&#xa;       │                   ▼&#xa;┌────────────      ┌───────────────┐&#xa;│ sum_odd =  │      │ ВВОД: num =   │&#xa;│ sum(A[1::2])│     │ int(input)    │&#xa;└───────────┘      └───────┬───────┘&#xa;       │                     ▼&#xa;┌────────────┐       ┌───────────────┐&#xa;│ difference │       │ Ввод валиден? │&#xa;│ = even -   │       │ (try/except)  │&#xa;│   odd      │       └──────────────┘&#xa;└──────┬─────┘          Да ▼  │ Нет&#xa;       │          ┌──────────┴──────────┐&#xa;       │          ▼                     ▼&#xa;       │   ┌───────────────┐    ┌───────────────┐&#xa;       │   │ A.append(num) │    │ ВЫВОД ОШИБКИ: │&#xa;       │   └───────┬───────┘    │ &quot;Введите целое│&#xa;       │           │            │   число&quot;      │&#xa;       │           │            └───────┬───────┘&#xa;       │           ▼                    │&#xa;       │   ┌───────────────┐            │&#xa;       │   │     break     │            │&#xa;       │   │ (выход из     │            │&#xa;       │   │  while True)  │            │&#xa;       │   └───────┬───────┘            │&#xa;       │           │                    │&#xa;       │           ▼                    │&#xa;       │   ┌───────────────┐            │&#xa;       │   │ i = i + 1     │◄───────────┘&#xa;       │   └───────┬───────┘&#xa;       │           │&#xa;       └───────────┘&#xa;           (Возврат к i &lt; 10)&#xa;           ▼&#xa;┌───────────────────┐&#xa;│ ВЫВОД РЕЗУЛЬТАТОВ │&#xa;│ (sum_even_idx,    │&#xa;│  sum_odd_idx,     │&#xa;│  difference)      │&#xa;└─────────┬─────────┘&#xa;          ▼&#xa;       ┌─────────┐&#xa;       │  КОНЕЦ  │&#xa;       └─────────" vertex="1">
