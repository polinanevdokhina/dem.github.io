        <mxCell id="jMu4TiEwKi8SUWL0U_Gk-25" parent="1" style="text;whiteSpace=wrap;" value="┌───────────────┐&#xa;│     НАЧАЛО    │&#xa;└───────┬───────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ A = []            │&#xa;│ i = 0             │&#xa;└───────┬───────────┘&#xa;        ▼&#xa;┌───────────────────┐&#xa;│ ВЫВОД:            │&#xa;│ &quot;Введите 10 чисел&quot;│&#xa;└───────┬───────────┘&#xa;        ▼&#xa;   ┌─────────────┐&#xa;   │   i &lt; 10?   │ ◄── Внешний цикл&#xa;   └──────┬──────┘&#xa;     Нет  │  Да&#xa;   ┌─────────────┐&#xa;   ▼              ▼&#xa;┌────────────  ┌───────────────────┐&#xa;│ max_val =  │  │ ВНУТРЕННИЙ ЦИКЛ   │&#xa;│ max(A)     │  │ (while True)      │&#xa;└───────────┘  └─────────┬─────────┘&#xa;       │                   ▼&#xa;┌────────────┐      ┌───────────────┐&#xa;│ count_max= │      │ ВВОД: num =   │&#xa;│ A.count(   │      │ int(input)    │&#xa;│  max_val)  │      └───────┬───────┘&#xa;└──────┬─────              ▼&#xa;       │            ┌───────────────┐&#xa;       │            │ Ввод валиден? │&#xa;       │            │ (try/except)  │&#xa;       │            └──────────────┘&#xa;       │               Да ▼  │ Нет&#xa;       │          ┌──────────┴──────────┐&#xa;       │          ▼                     ▼&#xa;       │   ┌───────────────┐    ┌───────────────┐&#xa;       │   │ A.append(num) │    │ ВЫВОД ОШИБКИ: │&#xa;       │   └───────┬───────┘    │ &quot;Введите целое│&#xa;       │           │            │   число&quot;      │&#xa;       │           │            └───────┬───────┘&#xa;       │           ▼                    │&#xa;       │   ┌───────────────┐            │&#xa;       │   │     break     │            │&#xa;       │   │ (выход из     │            │&#xa;       │   │  while True)  │            │&#xa;       │   └───────┬───────┘            │&#xa;       │           │                    │&#xa;       │           ▼                    │&#xa;       │   ┌───────────────┐            │&#xa;       │   │ i = i + 1     │◄───────────┘&#xa;       │   └───────┬───────┘&#xa;       │           │&#xa;       └───────────┘&#xa;           (Возврат к i &lt; 10)&#xa;           ▼&#xa;┌───────────────────┐&#xa;│ ВЫВОД РЕЗУЛЬТАТОВ │&#xa;│ (max_val,         │&#xa;│  count_max)       │&#xa;└─────────┬─────────┘&#xa;          ▼&#xa;       ┌─────────┐&#xa;       │  КОНЕЦ  │&#xa;       └─────────" vertex="1">
