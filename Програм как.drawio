        <mxCell id="jMu4TiEwKi8SUWL0U_Gk-18" parent="1" style="text;whiteSpace=wrap;" value="┌─────────┐&#xa;│  НАЧАЛО │&#xa;└────┬────┘&#xa;     ▼&#xa;┌─────────────────────────────┐&#xa;│ ВВОД: year = 2024           │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;        ┌─────────────────────────┐&#xa;        │ (year % 4 == 0 и        │&#xa;        │  year % 100 != 0) или   │&#xa;        │  (year % 400 == 0)?     │ ◄── Ромб (условие)&#xa;        └────────────┬────────────┘&#xa;          Да ▼       │ Нет&#xa;┌────────────────────┴────────────────────┐&#xa;▼                                         ▼&#xa;┌─────────────────────────┐     ┌───────────────────────────┐&#xa;│ ВЫВОД:                  │     │ ВЫВОД:                    │&#xa;│ &quot;2024 год — високосный.&quot;│     │ &quot;2024 год — не високосный.&quot;│&#xa;└────────────┬────────────┘     └────────────┬──────────────┘&#xa;             └───────────────┬───────────────┘&#xa;                             ▼&#xa;                          ┌─────────┐&#xa;                          │  КОНЕЦ  │&#xa;                          └─────────┘" vertex="1">
