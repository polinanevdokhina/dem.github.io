        <mxCell id="jMu4TiEwKi8SUWL0U_Gk-16" parent="1" style="text;whiteSpace=wrap;" value="┌─────────┐&#xa;│  НАЧАЛО │&#xa;└────┬────┘&#xa;     ▼&#xa;┌─────────────────────────────┐&#xa;│ ВВОД: a = 3.0               │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;┌─────────────────────────────┐&#xa;│ ВВОД: b = 4.0               │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;        ┌─────────────┐&#xa;        │ a &lt;= 0 или  │&#xa;        │ b &lt;= 0?     │&#xa;        └──────┬──────┘&#xa;      Да ▼     │ Нет&#xa;┌──────────────┴──────────────┐&#xa;│ ВЫВОД ОШИБКИ                │&#xa;│ «Длины должны быть &gt; 0!»    │&#xa;└──────────────┬──────────────┘&#xa;               ▼&#xa;       ┌───────────────┐&#xa;       │ ВЫЧИСЛЕНИЕ:   │&#xa;       │ hyp = √(3²+4²)│&#xa;       │       = 5.00  │&#xa;       └───────┬───────┘&#xa;               ▼&#xa;       ┌───────────────┐&#xa;       │ ВЫЧИСЛЕНИЕ:   │&#xa;       │ area=(3×4)/2  │&#xa;       │       = 6.00  │&#xa;       └───────┬───────┘&#xa;               ▼&#xa;┌─────────────────────────────┐&#xa;│ ВЫВОД:                      │&#xa;│ «Гипотенуза: 5.00»          │&#xa;│ «Площадь: 6.00»             │&#xa;└────────────┬────────────────┘&#xa;             ▼&#xa;          ┌─────────┐&#xa;          │  КОНЕЦ  │&#xa;          └─────────┘" vertex="1">
